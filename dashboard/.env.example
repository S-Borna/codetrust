STRIPE_WEBHOOK_SECRET=

# --- CodeTrust API ---
NEXT_PUBLIC_API_URL=https://api.codetrust.ai

# --- Database (Prisma) ---
DATABASE_URL=postgresql://localhost:5432/codetrust_dashboard
