{
    "name": "codetrust-dashboard",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "prisma db push --skip-generate && next build",
        "start": "next start",
        "lint": "next lint",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "postinstall": "prisma generate"
    },
    "dependencies": {
        "@next-auth/prisma-adapter": "^1.0.7",
        "@prisma/client": "^5.22.0",
        "@stripe/stripe-js": "^4.9.0",
        "next": "^14.2.0",
        "next-auth": "^4.24.0",
        "react": "^18.3.0",
        "react-dom": "^18.3.0",
        "stripe": "^17.4.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.48.0",
        "@testing-library/jest-dom": "^6.6.0",
        "@testing-library/react": "^16.1.0",
        "@types/node": "^22.0.0",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^5.1.4",
        "autoprefixer": "^10.4.0",
        "eslint": "^8.57.0",
        "eslint-config-next": "^14.2.0",
        "jsdom": "^25.0.0",
        "postcss": "^8.4.0",
        "prisma": "^5.22.0",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.6.0",
        "vitest": "^2.1.0"
    }
}
