{
    "name": "codetrust",
    "displayName": "CodeTrust",
    "description": "AI Governance Enforcement Platform — real-time BASH_ENV guard + PreToolUse interception, 3,006 rules, 8 enforcement layers, guided remediation. Intercepts AI agent commands BEFORE execution. Cross-language taint (7 languages), hallucination detection, AI attribution.",
    "version": "4.0.6",
    "publisher": "SaidBorna",
    "license": "SEE LICENSE IN LICENSE",
    "icon": "images/icon.png",
    "homepage": "https://codetrust.ai",
    "repository": {
        "type": "git",
        "url": "https://github.com/S-Borna/codetrust.git"
    },
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Linters",
        "Testing",
        "Other"
    ],
    "keywords": [
        "security",
        "ai-governance",
        "governance",
        "verification",
        "anti-patterns",
        "code-quality",
        "hallucination",
        "mcp",
        "claude-code",
        "cursor",
        "sql",
        "dockerfile",
        "yaml",
        "ci-cd",
        "react",
        "kubernetes",
        "sarif",
        "devops"
    ],
    "activationEvents": [
        "onStartupFinished",
        "onLanguage:python",
        "onLanguage:javascript",
        "onLanguage:typescript",
        "onLanguage:javascriptreact",
        "onLanguage:typescriptreact",
        "onLanguage:go",
        "onLanguage:rust",
        "onLanguage:json",
        "onLanguage:jsonc",
        "onLanguage:dockerfile",
        "onLanguage:sql",
        "onLanguage:yaml",
        "onLanguage:java",
        "onLanguage:csharp",
        "onLanguage:cpp",
        "onLanguage:c",
        "onLanguage:shellscript",
        "onLanguage:html",
        "onLanguage:terraform",
        "onLanguage:ruby",
        "onLanguage:php",
        "onLanguage:powershell"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "codetrust.scanFile",
                "title": "CodeTrust: Scan File"
            },
            {
                "command": "codetrust.guidedOnboarding",
                "title": "CodeTrust: Guided Onboarding"
            },
            {
                "command": "codetrust.createProfile",
                "title": "CodeTrust: Create CodeTrust Profile"
            },
            {
                "command": "codetrust.applyProfile",
                "title": "CodeTrust: Apply CodeTrust Profile"
            },
            {
                "command": "codetrust.healthCheck",
                "title": "CodeTrust: Health Check"
            },
            {
                "command": "codetrust.verifyImports",
                "title": "CodeTrust: Verify Imports"
            },
            {
                "command": "codetrust.verifyDockerfile",
                "title": "CodeTrust: Verify Dockerfile"
            },
            {
                "command": "codetrust.deepScan",
                "title": "CodeTrust: Deep Scan"
            },
            {
                "command": "codetrust.clearDiagnostics",
                "title": "CodeTrust: Clear Diagnostics"
            },
            {
                "command": "codetrust.scanWorkspace",
                "title": "CodeTrust: Scan Workspace"
            },
            {
                "command": "codetrust.governanceStatus",
                "title": "CodeTrust: Governance Status"
            },
            {
                "command": "codetrust.injectCopilotInstructions",
                "title": "CodeTrust: Inject Copilot Instructions"
            }
        ],
        "configuration": {
            "title": "CodeTrust",
            "properties": {
                "codetrust.apiUrl": {
                    "type": "string",
                    "default": "https://api.codetrust.ai",
                    "description": "CodeTrust API server URL (cloud default; set to your self-hosted API base URL if applicable)"
                },
                "codetrust.apiKey": {
                    "type": "string",
                    "default": "",
                    "description": "Deprecated: API key is stored in VS Code Secret Storage. Use 'CodeTrust: Guided Onboarding'. If set here, it will be migrated and cleared."
                },
                "codetrust.scanOnSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically scan files on save"
                },
                "codetrust.scanOnType": {
                    "type": "boolean",
                    "default": false,
                    "description": "Scan while typing using the embedded offline scanner (debounced)"
                },
                "codetrust.scanOnTypeDebounceMs": {
                    "type": "number",
                    "default": 600,
                    "description": "Debounce delay (ms) for scan while typing"
                },
                "codetrust.severityThreshold": {
                    "type": "string",
                    "enum": [
                        "INFO",
                        "WARN",
                        "BLOCK"
                    ],
                    "default": "INFO",
                    "description": "Minimum severity level to show as diagnostics"
                },
                "codetrust.enabledLanguages": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "python",
                            "javascript",
                            "typescript",
                            "go",
                            "rust",
                            "json",
                            "sql",
                            "yaml",
                            "java",
                            "csharp",
                            "cpp",
                            "shell",
                            "html",
                            "terraform",
                            "ruby",
                            "php",
                            "powershell"
                        ]
                    },
                    "default": [
                        "python",
                        "javascript",
                        "typescript",
                        "go",
                        "rust",
                        "json",
                        "sql",
                        "yaml",
                        "java",
                        "csharp",
                        "cpp",
                        "shell",
                        "html",
                        "terraform",
                        "ruby",
                        "php",
                        "powershell"
                    ],
                    "description": "Languages to scan"
                },
                "codetrust.scanType": {
                    "type": "string",
                    "enum": [
                        "static",
                        "deep"
                    ],
                    "default": "static",
                    "description": "Scan type: 'static' for fast regex-based, 'deep' for full analysis"
                },
                "codetrust.verifyImportsOnSave": {
                    "type": "boolean",
                    "default": false,
                    "description": "Verify package imports on save (requires network)"
                },
                "codetrust.timeout": {
                    "type": "number",
                    "default": 15000,
                    "description": "Request timeout in milliseconds"
                },
                "codetrust.governance.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable AI governance — intercept and validate AI agent actions before execution"
                },
                "codetrust.governance.mode": {
                    "type": "string",
                    "enum": [
                        "enforce",
                        "audit",
                        "off"
                    ],
                    "default": "enforce",
                    "description": "Governance mode: enforce (block violations), audit (log only), off (disabled)"
                },
                "codetrust.governance.blockHeredoc": {
                    "type": "boolean",
                    "default": true,
                    "description": "Block heredoc patterns in terminal commands (prevents file corruption)"
                },
                "codetrust.governance.blockEval": {
                    "type": "boolean",
                    "default": true,
                    "description": "Block eval/exec in terminal commands"
                },
                "codetrust.governance.blockGitPush": {
                    "type": "boolean",
                    "default": true,
                    "description": "Block AI agents from pushing to remote repositories"
                },
                "codetrust.governance.protectedPaths": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "LICENSE",
                        ".env",
                        ".env.production"
                    ],
                    "description": "Files that require confirmation before AI agent writes or deletes"
                },
                "codetrust.attribution.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable AI model attribution — monitors LLM API calls to track which model generates code (metadata only, no prompts/code captured)"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "node ./scripts/check-release-sync.js && npm run bundle",
        "verify:trust-dod": "node ./scripts/verify-trust-dod.js",
        "compile": "tsc -p ./",
        "bundle": "node ./scripts/esbuild.js && node ./scripts/obfuscate.js",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src --ext ts",
        "pretest": "npm run compile",
        "test": "node ./out/test/runTest.js",
        "package": "npx @vscode/vsce package"
    },
    "devDependencies": {
        "@types/glob": "^8.1.0",
        "@types/mocha": "^10.0.6",
        "@types/node": "^20.11.0",
        "@types/vscode": "^1.90.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "@vscode/test-electron": "^2.3.8",
        "@vscode/vsce": "^2.22.0",
        "eslint": "^8.56.0",
        "esbuild": "^0.20.0",
        "javascript-obfuscator": "^4.1.0",
        "mocha": "^10.3.0",
        "typescript": "^5.3.3"
    }
}