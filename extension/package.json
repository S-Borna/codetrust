{
    "name": "codetrust",
    "displayName": "CodeTrust",
    "description": "AI code safety platform — 133 rules, 10 enforcement layers, 3 capabilities no other tool has: AI Governance Gateway (57 real-time interception rules), Hallucination Detection (live import verification against PyPI/npm/crates.io), Trust Score with drift tracking. Blocks destructive AI agent actions before execution. Works with Claude Code, Cursor, and GitHub Copilot.",
    "version": "2.2.4",
    "publisher": "SaidBorna",
    "license": "SEE LICENSE IN LICENSE",
    "icon": "images/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/S-Borna/codetrust"
    },
    "homepage": "https://codetrust.saidborna.com",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Linters",
        "Testing",
        "Other"
    ],
    "keywords": [
        "security",
        "ai-safety",
        "governance",
        "verification",
        "anti-patterns",
        "code-quality",
        "hallucination",
        "mcp",
        "claude-code",
        "cursor",
        "sql",
        "dockerfile",
        "yaml",
        "ci-cd",
        "react",
        "kubernetes",
        "sarif",
        "devops"
    ],
    "activationEvents": [
        "onLanguage:python",
        "onLanguage:javascript",
        "onLanguage:typescript",
        "onLanguage:javascriptreact",
        "onLanguage:typescriptreact",
        "onLanguage:go",
        "onLanguage:rust",
        "onLanguage:dockerfile",
        "onLanguage:sql",
        "onLanguage:yaml"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "codetrust.scanFile",
                "title": "CodeTrust: Scan File"
            },
            {
                "command": "codetrust.verifyImports",
                "title": "CodeTrust: Verify Imports"
            },
            {
                "command": "codetrust.verifyDockerfile",
                "title": "CodeTrust: Verify Dockerfile"
            },
            {
                "command": "codetrust.deepScan",
                "title": "CodeTrust: Deep Scan"
            },
            {
                "command": "codetrust.clearDiagnostics",
                "title": "CodeTrust: Clear Diagnostics"
            },
            {
                "command": "codetrust.scanWorkspace",
                "title": "CodeTrust: Scan Workspace"
            },
            {
                "command": "codetrust.governanceStatus",
                "title": "CodeTrust: Governance Status"
            }
        ],
        "configuration": {
            "title": "CodeTrust",
            "properties": {
                "codetrust.apiUrl": {
                    "type": "string",
                    "default": "https://codetrust-api-production.up.railway.app",
                    "description": "CodeTrust API server URL (cloud default, or set to http://localhost:8000 for self-hosted)"
                },
                "codetrust.apiKey": {
                    "type": "string",
                    "default": "",
                    "description": "API key for authentication (X-API-Key header)"
                },
                "codetrust.scanOnSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically scan files on save"
                },
                "codetrust.severityThreshold": {
                    "type": "string",
                    "enum": [
                        "INFO",
                        "WARN",
                        "BLOCK"
                    ],
                    "default": "INFO",
                    "description": "Minimum severity level to show as diagnostics"
                },
                "codetrust.enabledLanguages": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "python",
                            "javascript",
                            "typescript",
                            "go",
                            "rust",
                            "sql"
                        ]
                    },
                    "default": [
                        "python",
                        "javascript",
                        "typescript",
                        "go",
                        "rust",
                        "sql"
                    ],
                    "description": "Languages to scan"
                },
                "codetrust.scanType": {
                    "type": "string",
                    "enum": [
                        "static",
                        "deep"
                    ],
                    "default": "static",
                    "description": "Scan type: 'static' for fast regex-based, 'deep' for full analysis"
                },
                "codetrust.verifyImportsOnSave": {
                    "type": "boolean",
                    "default": false,
                    "description": "Verify package imports on save (requires network)"
                },
                "codetrust.timeout": {
                    "type": "number",
                    "default": 15000,
                    "description": "Request timeout in milliseconds"
                },
                "codetrust.governance.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable AI governance — intercept and validate AI agent actions before execution"
                },
                "codetrust.governance.mode": {
                    "type": "string",
                    "enum": [
                        "enforce",
                        "audit",
                        "off"
                    ],
                    "default": "enforce",
                    "description": "Governance mode: enforce (block violations), audit (log only), off (disabled)"
                },
                "codetrust.governance.blockHeredoc": {
                    "type": "boolean",
                    "default": true,
                    "description": "Block heredoc patterns in terminal commands (prevents file corruption)"
                },
                "codetrust.governance.blockEval": {
                    "type": "boolean",
                    "default": true,
                    "description": "Block eval/exec in terminal commands"
                },
                "codetrust.governance.blockGitPush": {
                    "type": "boolean",
                    "default": true,
                    "description": "Block AI agents from pushing to remote repositories"
                },
                "codetrust.governance.protectedPaths": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "LICENSE",
                        ".env",
                        ".env.production"
                    ],
                    "description": "Files that require confirmation before AI agent writes or deletes"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "node ./scripts/check-release-sync.js && npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js",
        "package": "npx @vscode/vsce package"
    },
    "devDependencies": {
        "@types/glob": "^8.1.0",
        "@types/mocha": "^10.0.6",
        "@types/node": "^20.11.0",
        "@types/vscode": "^1.85.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "@vscode/test-electron": "^2.3.8",
        "@vscode/vsce": "^3.7.1",
        "eslint": "^8.56.0",
        "mocha": "^10.3.0",
        "typescript": "^5.3.3"
    }
}
