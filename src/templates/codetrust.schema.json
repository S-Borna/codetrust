{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeTrust Config",
  "type": "object",
  "properties": {
    "codetrust": {
      "type": "object",
      "properties": {
        "exclude_paths": {"type": "array", "items": {"type": "string"}},
        "ignore_rules": {"type": "array", "items": {"type": "string"}},
        "severity_overrides": {
          "type": "object",
          "description": "Override scan severity per rule_id (CLI only)",
          "additionalProperties": {
            "type": "string",
            "enum": ["BLOCK", "WARN", "INFO"]
          }
        },
        "governance": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "mode": {"type": "string", "enum": ["enforce", "audit", "off"]},
            "terminal": {
              "type": "object",
              "properties": {
                "block_heredoc": {"type": "boolean"},
                "block_eval": {"type": "boolean"},
                "block_sudo": {"type": "boolean"},
                "block_rm_rf": {"type": "boolean"},
                "block_curl_pipe_sh": {"type": "boolean"},
                "block_git_push": {"type": "boolean"},
                "block_chmod_777": {"type": "boolean"}
              },
              "additionalProperties": true
            },
            "files": {
              "type": "object",
              "properties": {
                "protected_paths": {"type": "array", "items": {"type": "string"}},
                "scan_before_write": {"type": "boolean"}
              },
              "additionalProperties": true
            },
            "packages": {
              "type": "object",
              "properties": {
                "verify_before_install": {"type": "boolean"},
                "block_suspicious_packages": {"type": "boolean"}
              },
              "additionalProperties": true
            },
            "audit": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "path": {"type": "string"},
                "retention_days": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": true
            },
            "webhooks": {
              "type": "object",
              "properties": {
                "url": {"type": "string"},
                "provider": {"type": "string"},
                "on_block": {"type": "boolean"},
                "on_warn": {"type": "boolean"}
              },
              "additionalProperties": true
            },
            "disabled_rules": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
